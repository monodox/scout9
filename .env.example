# ==============================================
# Scout9 Environment Configuration
# ==============================================
# Copy this file to .env.local and fill in your values

# ==============================================
# Application Settings
# ==============================================
APP_NAME=Scout9
APP_VERSION=0.1.0
DEBUG=True

# ==============================================
# Database Configuration (Required)
# ==============================================
# Supabase PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres?sslmode=require

# Fallback to SQLite for development (not recommended for production)
DATABASE_URL=sqlite:///./scout9.db

# ==============================================
# GRID API Configuration (Required for real data)
# ==============================================
# Get your API key from https://grid.gg/developers
GRID_API_KEY=your_grid_api_key_here

# GRID API Endpoints (default values, no need to change)
GRID_API_URL=https://api-op.grid.gg/central-data/graphql
GRID_CENTRAL_DATA_URL=https://api-op.grid.gg/central-data/graphql
GRID_SERIES_STATE_URL=https://api-op.grid.gg/series-state/v1
GRID_FILE_DOWNLOAD_URL=https://api-op.grid.gg/file-download/v1
GRID_WS_EVENTS_URL=wss://api-op.grid.gg/series-events/v1

# ==============================================
# Cache Configuration
# ==============================================
CACHE_ENABLED=True
CACHE_TTL=3600  # Cache time-to-live in seconds (1 hour)

# ==============================================
# Security & Authentication
# ==============================================
# IMPORTANT: Change these in production!
SECRET_KEY=your-secret-key-change-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==============================================
# Frontend Environment Variables
# ==============================================
# Vite will expose variables prefixed with VITE_
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key_here

# ==============================================
# Optional: Email Configuration (for future auth features)
# ==============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@scout9.dev

# ==============================================
# Optional: Logging & Monitoring
# ==============================================
# LOG_LEVEL=INFO
# SENTRY_DSN=your_sentry_dsn_here

# ==============================================
# Notes:
# ==============================================
# 1. Never commit .env.local to version control
# 2. Use strong, unique SECRET_KEY in production
# 3. GRID_API_KEY is required for fetching real match data
# 4. Without GRID_API_KEY, the app will use mock data
# 5. SUPABASE_DB_URL must include sslmode=require
# 6. Generate SECRET_KEY with: openssl rand -hex 32
