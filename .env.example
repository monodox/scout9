# ==============================================
# Scout9 Environment Configuration
# ==============================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ==============================================
# Database Configuration (Required)
# ==============================================
# Supabase PostgreSQL connection string
# Get from: Supabase Dashboard → Settings → Database → Connection String (Transaction mode)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.your_project:your_password@db.your_project.supabase.co:5432/postgres?sslmode=require

# ==============================================
# GRID API Configuration (Required)
# ==============================================
# Get your API key from: https://grid.gg/developers
# Without this key, the app will use mock data only
GRID_API_KEY=your_grid_api_key_here_from_grid_gg_developers
GRID_API_URL=https://api-op.grid.gg/central-data/graphql

# ==============================================
# Security (Required)
# ==============================================
# Generate a strong secret key with: openssl rand -hex 32
# IMPORTANT: Use a unique key in production!
SECRET_KEY=your-secret-key-change-in-production-min-32-characters

# ==============================================
# Optional: Cache Configuration
# ==============================================
CACHE_ENABLED=True
CACHE_TTL=3600

# ==============================================
# Optional: Frontend Configuration
# ==============================================
VITE_API_URL=http://localhost:8000
VITE_API_URL_PRODUCTION=https://your-backend.onrender.com
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key_here

# ==============================================
# Optional: Development Settings
# ==============================================
DEBUG=True
